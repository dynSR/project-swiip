        "discussion_histories_previous_status_check": {
          "name": "discussion_histories_previous_status_check",
          "value": "\"discussion_histories\".\"previous_status\" IN ('NEW', 'OPEN', 'DEFERRED', 'CLOSED')"
        },
        "discussion_histories_new_status_check": {
          "name": "discussion_histories_new_status_check",
          "value": "\"discussion_histories\".\"new_status\" IN ('NEW', 'OPEN', 'DEFERRED', 'CLOSED')"
        },
        "discussion_histories_transition_check": {
          "name": "discussion_histories_transition_check",
          "value": "(\n        (\"discussion_histories\".\"previous_status\" = 'NEW' AND \"discussion_histories\".\"new_status\" = 'OPEN')\n        OR\n        (\"discussion_histories\".\"previous_status\" = 'OPEN' AND \"discussion_histories\".\"new_status\" IN (\n            'DEFERRED',\n            'CLOSED'\n        ))\n        OR\n        (\"discussion_histories\".\"previous_status\" = 'DEFERRED' AND \"discussion_histories\".\"new_status\" IN (\n            'OPEN',\n            'CLOSED'\n        ))\n    )"
        },
        "discussion_histories_reason_length_check": {
          "name": "discussion_histories_reason_length_check",
          "value": "length(trim(\"discussion_histories\".\"reason\")) BETWEEN 1 AND 1000"
        }
      }
